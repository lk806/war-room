# 复制为 .env 后填入自己的值；.env 已被 .gitignore 忽略，不会提交
# 不填也能跑：接口与页面完全一致，只是内容来自内置样例（演示模式）

# ---------- 文本模型（任务拆分 / 会议纪要）----------
# 任何 OpenAI 兼容服务都可以：DeepSeek、OpenAI、硅基流动、通义千问…
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
# 单次调用超时（毫秒），默认 45s
# AI_TIMEOUT_MS=45000

# ---------- 语音识别 ----------
# 只支持 OpenAI 兼容的 /audio/transcriptions（如 OpenAI whisper-1）
ASR_API_KEY=
ASR_BASE_URL=https://api.openai.com/v1
ASR_MODEL=whisper-1
# 转写超时（毫秒），默认 120s
# ASR_TIMEOUT_MS=120000

# 强制走内置样例（即使配了 Key）
# AI_PROVIDER=mock

# ---------- AI 功能授权 ----------
# 新注册用户默认不能用 AI（纪要 / 拆分 / 转写），需要输入这串授权码自助开通
# 留空 = 关闭自助开通，只能用 npm run grant:ai 手动开通
AI_ACTIVATION_CODE=war-room-vip
# 同时最多跑几个 AI/ASR 调用（默认 3）
# AI_MAX_CONCURRENT=3
# 用户自带 Key（BYOK）的加密密钥；不填则从 AUTH_SECRET 派生。
# ⚠️ 一旦设置或更换，之前存过的用户 Key 会解密失败（按未配置处理，用户重新填一次即可）
# KEY_ENC_SECRET=

# ---------- 对象存储（可选）----------
# 配置后：上传的文件存到 Supabase Storage 的桶里，不占容器磁盘；
# 不配置：自动存本地磁盘（DATA_DIR/storage，Railway 上是挂载的 /data 卷）
# 注意：数据库仍然是本地 SQLite（内置 node:sqlite），不使用 Prisma / Postgres
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 桶不存在时请先在 Supabase 控制台 Storage 里创建
SUPABASE_BUCKET=war-room-files
# 桶是 public 时才把直链返回给前端；改成 private 后设为 false（下载会走签名 URL 代理）
# SUPABASE_PUBLIC_URLS=true

# ---------- 服务 ----------
# PORT=4000
# HOST=0.0.0.0
# DATA_DIR=./data
# LOG_LEVEL=info
# REMINDER_SWEEP_MS=60000

# ---------- 部署到公网时必须显式设置 ----------
# 会话签名密钥：不设会自动生成到 DATA_DIR/.auth-secret（容器重建后所有人被踢下线）
# AUTH_SECRET=换成 32 位以上随机字符串（例如 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"）
# 通过 HTTPS 访问时必须为 true，否则浏览器不会保存 Cookie
# COOKIE_SECURE=true
# 生产环境（影响日志与错误细节）
# NODE_ENV=production
# 单文件上传上限（字节），默认 200MB
# MAX_UPLOAD_BYTES=209715200
# 关闭自助注册（组员用邀请码加入已有账号；默认 true）
# REGISTER_ENABLED=true

# ---------- 限流（公网建议保持默认）----------
# 认证接口：同一 IP 每分钟最多几次（登录/注册/加入小组）
# RATE_LIMIT_AUTH_PER_MIN=40
# AI 接口：同一用户每分钟最多几次（任务拆分/转写/纪要）
# RATE_LIMIT_AI_PER_MIN=20
